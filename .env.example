# Utraya Environment Variables Template
# Copy this file locally only when needed. Do not commit real values.
# Production values must be configured in provider dashboards (Vercel/Supabase).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- App ---
NEXT_PUBLIC_SITE_URL=https://utraya.com
CRON_SECRET=YOUR_LONG_RANDOM_CRON_SECRET
DAILY_SYNC_MAX_CHANNELS_PER_RUN=50
DAILY_SYNC_TIME_BUDGET_MS=50000

# --- Security / Admin ---
CREDENTIAL_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_OR_HEX_KEY
SUPERADMIN_USERNAME=YOUR_SUPERADMIN_USERNAME
SUPERADMIN_PASSWORD_HASH=scrypt$16384$8$1$64$BASE64_SALT$BASE64_HASH
SUPERADMIN_SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET

# --- Optional: Direct API keys for server-side use ---
# YOUTUBE_API_KEY_PLATFORM=YOUR_PLATFORM_YOUTUBE_KEY
# GEMINI_API_KEY_PLATFORM=YOUR_PLATFORM_GEMINI_KEY
