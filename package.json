{
  "name": "utraya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "prelint": "npm run check-next-rootdir",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs,.cjs --ignore-pattern node_modules --ignore-pattern .next",
    "check-next-rootdir": "node scripts/security-contract/check-next-rootdir.mjs",
    "test:security-contract": "vitest run scripts/security-contract",
    "type-check": "tsc --noEmit",
    "check-comments": "node scripts/check-comments.mjs",
    "validate": "npm run check-comments && npm run lint && npm run type-check",
    "admin:hash": "node scripts/generate-admin-password-hash.mjs",
    "legal:hash": "node --import tsx scripts/hashLegal.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.6",
    "next": "16.3.8",
    "next-intl": "4.14.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "fast-glob": "file:./scripts/security-contract/fast-glob",
    "happy-dom": "^20.14.6",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "@swc/helpers": "0.5.21",
    "esbuild": "0.25.0",
    "glob": "10.5.0",
    "minimatch": "9.0.7",
    "vite": "6.4.3",
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "6.1.4",
    "browserslist": "4.28.7",
    "brace-expansion": "5.0.12"
  }
}
